# Optional. Without it, scoring uses the published formula in this repo and a live
# NEAR AI Cloud gateway attestation (no key required). With it, Cloakline also
# asks a TEE-hosted model to sign the same decision.
NEARAI_CLOUD_API_KEY=

# TEE model used only when NEARAI_CLOUD_API_KEY is set.
NEARAI_MODEL=zai-org/GLM-5.1-FP8

PORT=4173
